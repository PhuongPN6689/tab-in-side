{
  "manifest_version": 3,
  "name": "Tab-in-Side",
  "version": "1.1",
  "description": "Open any website or link in a mobile-view sidebar in Firefox.",
  "author": "Antigravity UI",
  "homepage_url": "https://github.com/PhuongPN6689/tab-in-side",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "menus",
    "storage",
    "declarativeNetRequest",
    "bookmarks",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Tab in Side",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-in-side@antigravity.ai",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}